<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Outside the Box Education — A Trusted Voice in Homeschooling</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap');

:root{
  --cream:#FAF3EC;
  --cream-deep:#F3E9DE;
  --charcoal:#2E2A27;
  --charcoal-soft:#5C5650;
  --rose:#C98C82;
  --rose-deep:#9C5F55;
  --blush:#F0DFD8;
  --blush-line:#E3C9BF;
  --radius-lg:20px;
  --radius-md:12px;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  background:var(--cream);
  color:var(--charcoal);
  font-family:'Inter', sans-serif;
  line-height:1.65;
}
@media (prefers-reduced-motion: reduce){ *{animation-duration:0.001s !important; transition-duration:0.001s !important;} }
a{color:inherit;}
img{max-width:100%; display:block;}
.eyebrow{
  font-family:'IBM Plex Mono', monospace;
  font-size:12px; letter-spacing:.12em; text-transform:uppercase;
  color:var(--rose-deep);
}
.wrap{max-width:1160px; margin:0 auto; padding:0 28px;}
h1,h2,h3{
  font-family:'Familjen Grotesk', sans-serif;
  font-weight:600;
  color:var(--charcoal);
  margin:0;
  letter-spacing:-0.01em;
}
p{margin:0 0 1rem;}

.box-mark{
  width:26px; height:26px; border:2.2px solid currentColor; border-radius:5px; position:relative; flex:none;
}
.box-mark::after{
  content:""; position:absolute; left:50%; top:-7px; width:12px; height:2.2px; background:currentColor;
  transform:translateX(-50%) rotate(-14deg);
}

header{
  position:sticky; top:0; z-index:50;
  background:rgba(250,243,236,0.92);
  backdrop-filter:blur(6px);
  border-bottom:1px solid var(--blush-line);
}
.nav{display:flex; align-items:center; justify-content:space-between; padding:10px 0;}
.brand{padding:4px 0;}
.brand{display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--charcoal);}
.brand img{height:92px; width:auto; display:block;}
.brand-foot img{height:64px; width:auto; display:block; border-radius:10px;}
.nav-links{display:flex; gap:28px; font-size:14.5px; font-weight:500;}
.nav-links a{text-decoration:none; border-bottom:2px solid transparent; padding-bottom:3px;}
.nav-links a:hover{border-color:var(--rose);}
.nav-cta{
  font-size:14px; font-weight:600;
  background:var(--rose-deep); color:#fff; padding:10px 20px; border-radius:30px;
  text-decoration:none; white-space:nowrap;
}
.nav-cta:hover{background:#84463d;}
.menu-btn{display:none; background:none; border:1.5px solid var(--charcoal); border-radius:8px; padding:8px 10px; font-size:16px; color:var(--charcoal); cursor:pointer;}

.hero{padding:56px 0 0;}
.hero-content{text-align:center; max-width:700px; margin:0 auto 36px;}
.hero-content .eyebrow{display:block; margin-bottom:14px;}
.hero-content h1{font-size:46px; line-height:1.14; margin:0 0 18px;}
.hero-content .lede{font-size:17.5px; color:var(--charcoal-soft); max-width:56ch; margin:0 auto;}
.hero-ctas{display:flex; gap:14px; margin-top:26px; flex-wrap:wrap; justify-content:center;}
.btn{
  font-size:14.5px; font-weight:600;
  padding:13px 24px; border-radius:30px; text-decoration:none; display:inline-block;
  border:1.5px solid transparent;
}
.btn-solid{background:var(--rose-deep); color:#fff;}
.btn-solid:hover{background:#84463d;}
.btn-outline{background:transparent; color:var(--charcoal); border-color:var(--charcoal);}
.btn-outline:hover{background:rgba(46,42,39,0.06);}
.hero-photo{
  position:relative; border-radius:28px; overflow:hidden;
  min-height:420px;
}
.hero-photo img{width:100%; height:100%; object-fit:cover; display:block; max-height:520px;}

.mission{padding:44px 0 8px; text-align:center;}
.mission p{
  font-family:'Familjen Grotesk', sans-serif; font-weight:500; font-size:21px; color:var(--charcoal-soft);
  max-width:52ch; margin:0 auto;
}

.section{padding:70px 0;}
.section-head{max-width:60ch; margin-bottom:36px;}
.section-head h2{font-size:30px; margin:10px 0 12px;}
.section-head .lede{color:var(--charcoal-soft); font-size:16.5px;}

.pillars{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
.pillar{background:var(--blush); border-radius:var(--radius-md); padding:26px 22px;}
.pillar .num{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--rose-deep); margin-bottom:10px; display:block;}
.pillar h3{font-size:18px; margin-bottom:8px;}
.pillar p{font-size:14.5px; color:var(--charcoal-soft); margin-bottom:0;}

.moments{padding:0 0 70px;}
.moments-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:14px;}
.moment{border-radius:var(--radius-md); overflow:hidden; aspect-ratio:1/1;}
.moment img{width:100%; height:100%; object-fit:cover; transition:transform .4s ease;}
.moment:hover img{transform:scale(1.05);}

.trust{background:var(--charcoal); color:var(--cream); padding:46px 0;}
.trust .wrap{display:flex; flex-wrap:wrap; gap:40px; justify-content:space-between; align-items:center;}
.trust-stat{min-width:170px; max-width:220px;}
.trust-stat .num{font-family:'Familjen Grotesk',sans-serif; font-weight:700; font-size:21px; line-height:1.2; display:block; margin-bottom:6px; color:#fff;}
.trust-stat .label{font-size:13px; color:#C9BFB6;}

.catalog{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
.cat-card{background:#fff; border:1px solid var(--blush-line); border-radius:var(--radius-md); overflow:hidden; display:flex; flex-direction:column;}
a.cat-card{text-decoration:none; color:inherit; transition:box-shadow .18s ease, transform .18s ease;}
a.cat-card:hover{box-shadow:0 8px 22px rgba(46,42,39,0.08); transform:translateY(-2px); border-color:var(--rose);}
a.cat-card:hover h3{color:var(--rose-deep);}
.cat-thumb{height:180px; overflow:hidden; position:relative;}
.cat-thumb img{width:100%; height:100%; object-fit:cover;}
.cat-body{padding:18px 20px 22px;}
.cat-tag{font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--rose-deep); margin-bottom:8px; display:block;}
.cat-card h3{font-size:17px; margin-bottom:8px;}
.cat-card p{font-size:14px; color:var(--charcoal-soft); margin-bottom:0;}

.testi-wrap{display:grid; grid-template-columns:0.9fr 1.1fr; gap:32px; align-items:center;}
.testi-photo{border-radius:var(--radius-lg); overflow:hidden; height:100%;}
.testi-photo img{width:100%; height:100%; object-fit:cover; min-height:320px;}
.testi-cards{display:flex; flex-direction:column; gap:16px;}
.testi-card{background:#fff; border:1px solid var(--blush-line); border-radius:var(--radius-md); padding:22px 24px;}
.testi-card p{font-size:15.5px; color:var(--charcoal); margin-bottom:12px;}
.testi-card .who{font-size:13px; font-weight:600; color:var(--rose-deep);}

.signup-card{background:var(--blush); border-radius:var(--radius-lg); padding:44px; display:grid; grid-template-columns:1fr auto; gap:32px; align-items:center;}
.signup-card h2{font-size:26px; margin-bottom:10px;}
.signup-card .lede{color:var(--charcoal-soft); margin-bottom:0;}
.signup{display:flex; gap:10px; flex-wrap:wrap;}
.signup input[type=email]{
  font-family:'Inter',sans-serif; font-size:14px;
  padding:13px 16px; border:1.5px solid var(--rose-deep); border-radius:30px; background:#fff; min-width:240px;
}
.signup input[type=email]:focus{outline:3px solid var(--rose); outline-offset:1px;}

footer{background:var(--charcoal); color:#C9BFB6; padding:52px 0 34px; margin-top:20px;}
.foot-grid{display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:32px; margin-bottom:36px;}
footer h4{font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#8E857D; margin:0 0 14px; font-weight:600;}
footer ul{list-style:none; margin:0; padding:0;}
footer li{margin-bottom:9px; font-size:14.5px;}
footer a{text-decoration:none;}
footer a:hover{text-decoration:underline;}
.foot-bottom{border-top:1px solid #453F3A; padding-top:22px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-size:12.5px; color:#8E857D;}

@media (max-width:900px){
  .hero-content h1{font-size:34px;}
  .pillars{grid-template-columns:repeat(2,1fr);}
  .catalog{grid-template-columns:repeat(2,1fr);}
  .testi-wrap{grid-template-columns:1fr;}
  .testi-photo img{min-height:220px;}
  .foot-grid{grid-template-columns:1fr 1fr;}
  .signup-card{grid-template-columns:1fr;}
  .moments-grid{grid-template-columns:repeat(3,1fr);}
}
@media (max-width:640px){
  .nav-links{display:none;}
  .menu-btn{display:inline-block;}
  .hero-photo{min-height:280px;}
  .hero-content h1{font-size:28px;}
  .pillars{grid-template-columns:1fr;}
  .catalog{grid-template-columns:1fr;}
  .foot-grid{grid-template-columns:1fr 1fr;}
  .mission p{font-size:18px;}
  .moments-grid{grid-template-columns:repeat(2,1fr);}
}
:focus-visible{outline:3px solid var(--rose); outline-offset:2px;}
</style>
</head>
<body>
<h1>
  This will be the newest page of our website!
  </h1>
  </body>
    </html>
